rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 백업 코드(ABCDE-12345 형식)를 아는 사람만 그 코드의 문서를 읽고 쓸 수 있어요.
    // 목록 조회(list)는 막아서 다른 사람의 코드를 찾아볼 수 없어요.
    match /sync/{code} {
      allow get, create, update, delete: if code.matches('^[A-Z0-9]{5}-[A-Z0-9]{5}$');
      match /st/{chunk} {
        allow get, create, update, delete: if code.matches('^[A-Z0-9]{5}-[A-Z0-9]{5}$');
      }
      match /img/{id} {
        allow get, create, update, delete: if code.matches('^[A-Z0-9]{5}-[A-Z0-9]{5}$');
      }
    }
  }
}
